<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:layout_marginBottom="6dp"
    android:background="@drawable/bg_terminal_card"
    android:padding="12dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?android:attr/selectableItemBackground">

    <!-- Compact strip: name + bars + key numbers -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- Status dot -->
        <View
            android:id="@+id/gpuDot"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_status_dot_offline" />

        <!-- Terminal name -->
        <TextView
            android:id="@+id/tvStripName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="@color/on_surface"
            android:singleLine="true"
            android:ellipsize="middle" />

        <!-- GPU util bar + percent -->
        <ProgressBar
            android:id="@+id/pbStripUtil"
            style="@android:style/Widget.ProgressBar.Horizontal"
            android:layout_width="48dp"
            android:layout_height="6dp"
            android:layout_marginStart="8dp"
            android:max="100"
            android:progressDrawable="@drawable/bg_progress_bar" />

        <TextView
            android:id="@+id/tvStripUtil"
            android:layout_width="36dp"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/on_surface"
            android:gravity="end"
            android:layout_marginStart="4dp" />

        <!-- VRAM compact -->
        <TextView
            android:id="@+id/tvStripVram"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="11sp"
            android:textColor="@color/on_surface_variant"
            android:layout_marginStart="8dp" />

        <!-- Temp -->
        <TextView
            android:id="@+id/tvStripTemp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="11sp"
            android:textColor="@color/on_surface_variant"
            android:layout_marginStart="8dp" />
    </LinearLayout>

    <!-- Expanded detail (hidden by default) -->
    <LinearLayout
        android:id="@+id/expandedDetail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone"
        android:layout_marginTop="10dp">

        <!-- GPU detail rows -->
        <LinearLayout
            android:id="@+id/detailGpuRows"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <!-- Training metrics -->
        <TextView
            android:id="@+id/tvDetailTraining"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:textColor="@color/on_surface_variant"
            android:fontFamily="monospace"
            android:visibility="gone"
            android:layout_marginTop="8dp" />

        <!-- Processes -->
        <TextView
            android:id="@+id/tvDetailProcs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="11sp"
            android:textColor="@color/on_surface_variant"
            android:fontFamily="monospace"
            android:visibility="gone"
            android:layout_marginTop="6dp" />
    </LinearLayout>
</LinearLayout>
